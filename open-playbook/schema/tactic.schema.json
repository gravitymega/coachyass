{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tactic.schema.json",
  "title": "Fiche Open Playbook / Open Playbook card",
  "description": "Coordonnées en pieds sur un demi-terrain : ligne de fond en haut (y = 0), panier en (25, 5.25), ligne médiane en y = 47.",
  "type": "object",
  "required": ["id", "cat", "lvl", "name", "sum", "why", "counter", "used", "keys"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "cat": { "type": "string" },
    "family": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "lvl": { "type": "integer", "minimum": 1, "maximum": 3 },
    "review": { "enum": ["pending", "approved"] },
    "name": { "$ref": "#/definitions/text" },
    "sum": { "$ref": "#/definitions/text" },
    "why": { "$ref": "#/definitions/text" },
    "counter": { "$ref": "#/definitions/text" },
    "used": { "$ref": "#/definitions/text" },
    "keys": { "$ref": "#/definitions/textList" },
    "start": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": { "^x?[1-5]$": { "$ref": "#/definitions/point" } },
      "properties": { "b": { "type": "string", "pattern": "^[1-5]$" } }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["c"],
        "additionalProperties": false,
        "properties": {
          "m": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^x?[1-5]$": {
                "type": "array",
                "items": [{ "type": "number" }, { "type": "number" }, { "enum": ["c", "d", "s", "m"] }],
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "p": { "type": "string", "pattern": "^[1-5]$" },
          "c": { "$ref": "#/definitions/text" }
        }
      }
    },
    "duration": { "type": "integer", "minimum": 1, "maximum": 120 },
    "equipment": { "$ref": "#/definitions/text" },
    "players": { "type": "string", "minLength": 1 },
    "age": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["U11", "U13", "U15", "U17", "seniors", "pro"] }
    },
    "variants": { "$ref": "#/definitions/textList" }
  },
  "dependencies": { "steps": ["start"] },
  "definitions": {
    "text": {
      "type": "object",
      "required": ["fr", "en"],
      "additionalProperties": false,
      "properties": {
        "fr": { "type": "string", "pattern": "\\S" },
        "en": { "type": "string", "pattern": "\\S" }
      }
    },
    "textList": {
      "type": "object",
      "required": ["fr", "en"],
      "additionalProperties": false,
      "properties": {
        "fr": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } },
        "en": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "\\S" } }
      }
    },
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
  }
}
